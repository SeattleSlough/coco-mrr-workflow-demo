[0m13:53:01.254721 [debug] [Thread-2 (]: On model.saas_billing_project.monthly_recurring_revenue: create or replace transient table SAAS_BILLING.ANALYTICS.monthly_recurring_revenue
    
    
    
    
    

    as (with months as (
    select distinct date_trunc('month', invoice_date) as month
    from SAAS_BILLING.ANALYTICS.stg_invoices
),

subscription_months as (
    select
        s.subscription_id,
        s.customer_id,
        m.month
    from SAAS_BILLING.ANALYTICS.stg_subscriptions s
    cross join months m
    left join SAAS_BILLING.ANALYTICS.stg_cancellations c
        on s.subscription_id = c.subscription_id
    where m.month >= date_trunc('month', s.start_date)
      and (c.cancellation_date is null or m.month < date_trunc('month', c.cancellation_date))
),

priced as (
    select
        sm.subscription_id,
        sm.customer_id,
        sm.month,
        coalesce(
            (
                select pc.new_price
                from SAAS_BILLING.ANALYTICS.stg_plan_changes pc
                where pc.subscription_id = sm.subscription_id
                  and date_trunc('month', pc.change_date) <= sm.month
                order by pc.change_date desc
                limit 1
            ),
            s.monthly_price
        ) as effective_price
    from subscription_months sm
    join SAAS_BILLING.ANALYTICS.stg_subscriptions s
        on sm.subscription_id = s.subscription_id
)

select
    month,
    sum(effective_price) as mrr
from priced
group by month
order by month
    )

